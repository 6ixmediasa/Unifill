    "build:production": "eas build -p android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "latest",
    "@react-native-async-storage/async-storage": "latest",
    "expo": "~57.0.0",
    "expo-build-properties": "latest",
    "expo-document-picker": "latest",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "latest",
    "expo-image-picker": "latest",
    "expo-notifications": "~57.0.9",
    "expo-print": "latest",
    "expo-router": "~57.0.11",
    "expo-sharing": "latest",
    "expo-splash-screen": "latest",
    "expo-sqlite": "latest",
    "expo-status-bar": "latest",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-google-mobile-ads": "latest",
    "react-native-safe-area-context": "latest",
    "react-native-screens": "latest",
    "react-native-svg": "latest",
    "expo-constants": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "typescript": "latest",
    "@types/node": "latest",
    "babel-preset-expo": "latest"
  }
